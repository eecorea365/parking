rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /parking/tesla-model-y {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == "eecorea@gmail.com";
    }
  }
}
